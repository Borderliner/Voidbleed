# Template file for 'voidbleed-installer'
# files/ is staged by scripts/build-packages.sh: the statically linked
# installer built from installer/, and a copy of catalog/.
pkgname=voidbleed-installer
version=20260917
revision=1
depends="btrfs-progs cryptsetup curl dosfstools e2fsprogs tar util-linux xbps"
short_desc="Voidbleed installer (TUI and unattended)"
maintainer="@MAINTAINER@"
license="MIT"
homepage="@HOMEPAGE@"
nostrip=yes

do_install() {
	vlicense "${FILESDIR}/LICENSE"
	vbin "${FILESDIR}/voidbleed-installer"
	vmkdir usr/share/voidbleed/catalog
	vcopy "${FILESDIR}/catalog/*" usr/share/voidbleed/catalog
}
