# Settings substituted into packages/srcpkgs at build time (scripts/build-packages.sh).
# Placeholders in templates and overlays: @REPO_URL@ @HOMEPAGE@ @MAINTAINER@

# Where the signed repository is served from. Empty = not hosted: packages are
# only built into build/repo (for the ISO) and no repo entry is installed.
VOIDBLEED_REPO_URL=""
VOIDBLEED_HOMEPAGE="https://voidbleed.invalid"
VOIDBLEED_MAINTAINER="reza <global.takeover7@gmail.com>"

# Private RSA key used by xbps-rindex --sign. Never commit it.
VOIDBLEED_SIGNING_KEY="${HOME}/.local/share/voidbleed/keys/repo-signing.pem"
