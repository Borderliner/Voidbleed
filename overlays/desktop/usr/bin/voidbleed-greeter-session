#!/bin/sh
# Start the Noctalia greeter.
#
# The boot splash is released by greetd's own service script, which runs as
# root: plymouthd ignores everyone else, and greetd starts this as _greeter.
# The wrapper stays because /etc/greetd/config.toml points at it.
exec /usr/bin/noctalia-greeter-session "$@"
