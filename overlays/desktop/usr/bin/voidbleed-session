#!/bin/sh
# Start the Voidbleed desktop with a session D-Bus.
#
# Greeters launch the Exec line of a wayland-sessions entry as a program, so
# niri's own entry ("dbus-run-session niri --session") can lose its wrapper and
# niri then hangs in dbus-launch --autolaunch with no bus to talk to.
#
# The boot splash is not this script's to release: plymouthd answers root and
# nobody else, so greetd's service script quits it before the greeter starts.
# A session started straight from a tty leaves plymouthd running until a root
# "plymouth quit" -- harmless, since the compositor takes the display anyway.
exec dbus-run-session niri --session
